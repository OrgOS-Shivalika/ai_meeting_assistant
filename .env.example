# ============================================================================
# AI Meeting Assistant — environment configuration
# Copy to .env and fill in. Lines that already have a sensible default in
# settings.py are commented out.
# ============================================================================

# ---- Database --------------------------------------------------------------
# Default points at the host-Postgres setup. Override to point at the compose
# Postgres (port 5433) or any other instance.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/meeting_ai
# DOCKER_DATABASE_URL is what the Celery worker (running inside compose) uses
# to reach Postgres. Defaults to the compose service.
# DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/meeting_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_ai

# ---- Auth ------------------------------------------------------------------
AUTH_SECRET_KEY=change-me-in-production

# ---- Async infra (Phase 1B) -----------------------------------------------
# Toggle the meeting pipeline between in-process (false) and Celery (true).
# Compose worker forces this on.
USE_CELERY=false
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- Object storage (Phase 1C) --------------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=meeting-ai-documents
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true

# ---- AI providers ----------------------------------------------------------
OPEN_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Recall.ai -------------------------------------------------------------
RECALL_API_KEY=
BASE_URL=https://ap-northeast-1.recall.ai/api/v1

# ---- Google OAuth ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
APP_PUBLIC_URL=http://localhost:8000

# ---- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000

# ---- Langfuse (agents_v2 tracing) -----------------------------------------
# Leave all three blank for local dev without tracing — if ANY is missing
# the SDK becomes a no-op and meetings still process, just untraced.
#
# LANGFUSE_HOST DEFAULTS TO https://cloud.langfuse.com WHEN UNSET. That
# default is the trap: we self-host, so an environment that forgets this
# var sends self-hosted keys to the cloud API, fails auth inside a wrapped
# block, and drops tracing silently. Always set it explicitly per
# environment. `LANGFUSE_BASE_URL` is accepted as an alias.
#   local   → http://localhost:3000        (the docker-compose service)
#   Railway → http://langfuse.railway.internal:3000  (private networking)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Server-side only — consumed by the docker-compose `langfuse` service,
# not by the app. Generate fresh per environment, never reuse across them:
#   NEXTAUTH_SECRET / SALT   openssl rand -base64 32
#   ENCRYPTION_KEY           openssl rand -hex 32   (must be 32-byte hex)
# NEXTAUTH_URL must match the URL you open in the browser or login
# redirects break. The INIT_* vars pin the API keys on first boot so the
# two keys above can be filled in ahead of time; they are ignored once
# those rows exist, so it is safe to leave them set.
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ---- Memory backend (mem0 — see MEM0_IMPLEMENTATION_PLAN.md) --------------
# MEMORY_BACKEND: 'native' (org_memory_facts, default) or 'mem0'.
MEMORY_BACKEND=native
# MEM0_API_KEY selects the mem0 MODE:
#   SET   → MANAGED platform (mem0 hosts the store; get the key at app.mem0.ai)
#   UNSET → OSS self-hosted (mem0's own table in this Postgres)
MEM0_API_KEY=
# Phase 4 — conversational (session) memory in /ask. Adds ~1 LLM call/turn.
MEMORY_CHAT_ENABLED=false
